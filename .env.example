# PRW-Wild Notification & Delivery Configuration
# Default mode is offline simulated dispatch (zero credentials required).
# Real delivery fails closed unless valid credentials and verified recipient opt-ins are provided.

ALERT_MODE=simulated
REAL_DELIVERY_ENABLED=false

# --- Optional Real SMS Provider (e.g. Twilio / Sinch) ---
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE_NUMBER=

# --- Optional Real Email Provider (e.g. SendGrid / SMTP) ---
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=alerts@prw-wild.example.org

# --- System & Sound Configuration ---
ALARM_AUDIO_ENABLED=true
WEB_PORT=8000
WEB_HOST=127.0.0.1
